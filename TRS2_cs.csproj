<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>TRS2</AssemblyName>
    <RootNamespace>TRS2</RootNamespace>
    <Title>TRS2</Title>
    <Product>TRS2</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\gui\controls\**" />
    <Compile Remove="src\temp\**" />
    <EmbeddedResource Remove="src\gui\controls\**" />
    <EmbeddedResource Remove="src\temp\**" />
    <None Remove="src\gui\controls\**" />
    <None Remove="src\temp\**" />
    <Page Remove="src\gui\controls\**" />
    <Page Remove="src\temp\**" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\gui\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

</Project>
