<Application x:Class="TRS2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TRS2"
             StartupUri="MainWindow.xaml">

    <!--
        Common GUI formatting lives here.

        Future pages automatically get the same appearance for GroupBox,
        TextBox, CheckBox and DataGrid controls.  A future array table therefore
        needs only a DataGrid plus one DataGridColumn line per member.
    -->
    <Application.Resources>

        <!-- =============================================================
             GENERAL
             ============================================================= -->

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#CCD8E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B8BDC2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <!-- =============================================================
             SINGLE-OBJECT PARAMETER ROW

             Every row has the same compact label/value geometry.
             Usage on a page stays on one line, for example:

             <local:ParmRow Header="NumBins"><TextBox Text="{Binding NumBins}" /></local:ParmRow>
             ============================================================= -->

        <Style TargetType="{x:Type local:ParmRow}">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:ParmRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              Margin="4,0,6,0"
                                              VerticalAlignment="Center" />

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Content"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- =============================================================
             ARRAY / TABLE PARAMETERS

             This implicit style applies to every DataGrid on every page.
             ============================================================= -->

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D3D3D3" />
            <Setter Property="VerticalGridLinesBrush" Value="#D3D3D3" />
            <Setter Property="BorderBrush" Value="#D3D3D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="White" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="ColumnHeaderHeight" Value="25" />
            <Setter Property="ColumnWidth" Value="80" />
            <Setter Property="SelectionUnit" Value="Cell" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="BorderBrush" Value="#D3D3D3" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </Application.Resources>
</Application>
