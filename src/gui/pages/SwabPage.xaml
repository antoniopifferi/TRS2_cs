<Page x:Class="TRS2.SwabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:TRS2"
      mc:Ignorable="d"
      Title="SwabPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
        <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Swab" Grid.Column="0" DataContext="{Binding Swab}">
                    <StackPanel>
                        <local:ParmRow Header="Type"><ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="REAL" /><ComboBoxItem Content="VIRTUAL" /></ComboBox></local:ParmRow>
                        <local:ParmRow Header="Meas"><ComboBox SelectedValue="{Binding Meas, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="HIST" /><ComboBoxItem Content="CORR" /></ComboBox></local:ParmRow>
                        <local:ParmRow Header="SaveTags"><CheckBox IsChecked="{Binding SaveTags, UpdateSourceTrigger=PropertyChanged}" /></local:ParmRow>
                        <local:ParmRow Header="SplitFile"><ComboBox SelectedValue="{Binding SplitFile, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="NO" /><ComboBoxItem Content="LOOP1" /><ComboBoxItem Content="LOOP2" /><ComboBoxItem Content="LOOP3" /><ComboBoxItem Content="LOOP4" /><ComboBoxItem Content="LOOP5" /></ComboBox></local:ParmRow>
                        <local:ParmRow Header="FileVirt"><TextBox Text="{Binding FileVirt, UpdateSourceTrigger=PropertyChanged}" /></local:ParmRow>
                        <local:ParmRow Header="Frequency Divider"><TextBox Text="{Binding FrequencyDivider, UpdateSourceTrigger=PropertyChanged}" /></local:ParmRow>
                        <local:ParmRow Header="Frequency Multiplier"><TextBox Text="{Binding FrequencyMultiplier, UpdateSourceTrigger=PropertyChanged}" /></local:ParmRow>
                        <local:ParmRow Header="Filter"><CheckBox IsChecked="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" /></local:ParmRow>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="SwabSetting" Grid.Column="1">
                <DataGrid ItemsSource="{Binding Swab.Setting}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="All" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinWidth="540">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" IsReadOnly="True" Width="90" />
                        <DataGridTemplateColumn Header="Type" Width="90">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="NONE" /><ComboBoxItem Content="SYNC" /><ComboBoxItem Content="SIGN" /></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Level (V)" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Delay (ps)" Binding="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Deadtime (ps)" Binding="{Binding Deadtime, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                        <DataGridTemplateColumn Header="Hysteresis" Width="100">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Hysteresis, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="none" /><ComboBoxItem Content="1 mV" /><ComboBoxItem Content="20 mV" /><ComboBoxItem Content="70 mV" /></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>
