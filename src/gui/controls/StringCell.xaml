<UserControl x:Class="TRS2.StringCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <TextBox Padding="2"
             VerticalContentAlignment="Center"
             Text="{Binding Value, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
</UserControl>
