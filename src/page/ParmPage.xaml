<Page x:Class="TRS2.ParmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:TRS2"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="ParmPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <controls:ColumnGroup Header="Group1"
                                      DataItem="{Binding Group1}"
                                      Rows="{Binding Group1Rows}" />

                <controls:ColumnGroup Header="Group2"
                                      DataItem="{Binding Group2}"
                                      Rows="{Binding Group2Rows}" />
            </StackPanel>

            <controls:TableGroup Header="Loop"
                                 Margin="0,0,20,12"
                                 CornerText="Parameter"
                                 ColumnHeaderPrefix="Loop "
                                 ItemsSource="{Binding Loop}"
                                 Rows="{Binding LoopRows}" />
        </StackPanel>
    </ScrollViewer>
</Page>
